# Khai báo trong GitHub → Settings → Secrets and variables → Actions (không commit giá trị thật).

# Bắt buộc
ANTHROPIC_API_KEY=            # Khóa Claude API (console.anthropic.com), tính phí theo token
AGENT_PUBLISH_TOKEN=          # Mã đăng bài: chuỗi ngẫu nhiên ≥ 16 ký tự; đăng ký bản băm bằng workflow "enroll" (xem DEPLOYMENT.md)

# Tùy chọn
JINA_API_KEY=                 # Jina Reader (r.jina.ai) chạy được không cần khóa nhưng giới hạn lượt thấp hơn
CLAUDE_MODEL=claude-opus-5-5  # Model viết bài
CLAUDE_EFFORT=medium          # low | medium | high | xhigh | max (cao hơn = kỹ hơn, tốn token hơn)
MIN_WORDS=2500                # Số từ tối thiểu; thiếu thì viết bù chương Case Study (tối đa 2 lần)
SITE_URL=https://hunghienhoa.com
# GITHUB_TOKEN do GitHub Actions tự cấp, dùng cho GitHub Search API.
# DRY_RUN=1                   # Chạy thử: viết bài và ảnh vào scripts/out/, không đăng
